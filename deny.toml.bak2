[licenses]
allow = [
    "MIT",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "Unicode-DFS-2016",
]

deny = [
    "GPL-3.0",
    "AGPL-3.0",
]

[bans]
deny = [
    { crate = "failure", reason = "deprecated and unmaintained" },
    { crate = "failure_derive", reason = "deprecated and unmaintained" },
]

[advisories]
unmaintained = "all"
unsound = "all"

# Yanked uses allow/warn/deny in v0.19.x
yanked = "warn"

# v0.19.x expects this key

# v0.19.x expects this key
ignore = []
